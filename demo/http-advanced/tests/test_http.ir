module AdvancedTests {
  public module fun equal(name: String, actual: Object, expected: Object) -> Nil {
    if actual != expected { print("FAIL " + name); print(actual); raise :AdvancedTestFailure }
    print("PASS " + name)
    nil
  }

  public module fun check(name: String, request: String, status: String, contentType: String, body: String) -> Nil {
    let allow = if status == "405 Method Not Allowed" { "Allow: GET\r\n" } else { "" }
    let expected = "HTTP/1.1 " + status + "\r\nContent-Type: " + contentType + "\r\nContent-Length: " + body.byte_length().to_string() + "\r\nConnection: close\r\n" + allow + "X-Iris-Pipeline: advanced_v1\r\n\r\n" + body
    AdvancedTests.equal(name, Http.response(request), expected)
  }

  public module fun bad(name: String, request: String) -> Nil {
    AdvancedTests.check(name, request, "400 Bad Request", "text/plain; charset=utf-8", "Bad Request\n")
  }

  public module fun run() -> Nil {
    let plain = "text/plain; charset=utf-8"
    let root = "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n"
    AdvancedTests.check("unicode_root_byte_length", root, "200 OK", plain, "你好，Iris!\n")
    AdvancedTests.check("health_json", "GET /health HTTP/1.1\r\nHost: localhost\r\n\r\n", "200 OK", "application/json", "{\"status\":\"ok\"}\n")
    AdvancedTests.check("double_json_integer", "GET /double?value=21 HTTP/1.1\r\nHost: localhost\r\n\r\n", "200 OK", "application/json", "{\"doubled\":42}\n")
    AdvancedTests.check("double_negative_bound", "GET /double?value=-1000 HTTP/1.1\r\nHost: localhost\r\n\r\n", "200 OK", "application/json", "{\"doubled\":-2000}\n")
    AdvancedTests.check("double_positive_bound", "GET /double?value=1000 HTTP/1.1\r\nHost: localhost\r\n\r\n", "200 OK", "application/json", "{\"doubled\":2000}\n")
    let wrongType = "{\"error\":\"integer -1000..1000 required\"}\n"
    for value in ["true", "null", "\"21\"", "[]", "{}", "1001", "-1001"] {
      AdvancedTests.check("double_reject_" + value, "GET /double?value=" + value + " HTTP/1.1\r\nHost: localhost\r\n\r\n", "422 Unprocessable Content", "application/json", wrongType)
    }
    for target in ["/double", "/double?other=2", "/double?value=", "/double?value=oops", "/double?value=1.5", "/double?value=2&other=3", "/double?value=%32", "/double?value=2?value=3", "/double?value=[[[[[0]]]]]"] {
      AdvancedTests.bad("double_bad_query_" + target, "GET " + target + " HTTP/1.1\r\nHost: localhost\r\n\r\n")
    }
    AdvancedTests.check("controlled_failure", "GET /fail HTTP/1.1\r\nHost: localhost\r\n\r\n", "500 Internal Server Error", plain, "Controlled Failure\n")
    AdvancedTests.check("success_after_failure", root, "200 OK", plain, "你好，Iris!\n")
    AdvancedTests.check("unknown", "GET /missing HTTP/1.1\r\nHost: localhost\r\n\r\n", "404 Not Found", plain, "Not Found\n")
    AdvancedTests.check("query_ignored_on_root", "GET /?x=y HTTP/1.1\r\nHost: localhost\r\n\r\n", "200 OK", plain, "你好，Iris!\n")
    for method in ["POST", "CUSTOM", "1GET", "123", "nil", "get"] {
      AdvancedTests.check("method_" + method, method + " / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 10\r\n\r\n", "405 Method Not Allowed", plain, "Method Not Allowed\n")
    }
    AdvancedTests.check("head_empty", "HEAD / HTTP/1.1\r\nHost: localhost\r\n\r\n", "405 Method Not Allowed", plain, "")
    AdvancedTests.check("mixed_host_and_zero_length", "GET / HTTP/1.1\r\nhOsT:\tlocalhost:8081 \t\r\nX: one:two\r\nContent-Length: 000\r\n\r\n", "200 OK", plain, "你好，Iris!\n")
    for request in ["", "GET / HTTP/1.1\r\n", "GET / HTTP/1.1\nHost: localhost\n\n", "GET  / HTTP/1.1\r\nHost: localhost\r\n\r\n", "GET HTTP/1.1\r\nHost: localhost\r\n\r\n", "G(ET / HTTP/1.1\r\nHost: localhost\r\n\r\n", "GET / HTTP/1.0\r\nHost: localhost\r\n\r\n", "GET http://localhost/ HTTP/1.1\r\nHost: localhost\r\n\r\n", "GET /#x HTTP/1.1\r\nHost: localhost\r\n\r\n", "GET / HTTP/1.1\r\n\r\n", "GET / HTTP/1.1\r\nHost: \t\r\n\r\n", "GET / HTTP/1.1\r\nHost: localhost\r\nHOST: localhost\r\n\r\n", "GET / HTTP/1.1\r\nHost: local host\r\n\r\n", "GET / HTTP/1.1\r\nHost: a,b\r\n\r\n", "GET / HTTP/1.1\r\nHost localhost\r\n\r\n", "GET / HTTP/1.1\r\nHost : localhost\r\n\r\n", "GET / HTTP/1.1\r\nHost: localhost\r\n folded\r\n\r\n"] {
      AdvancedTests.bad("malformed_framing_host", request)
    }
    for value in ["a\nb", "a\rb", "\u{0}", "\u{7f}", "\u{e9}"] {
      AdvancedTests.bad("header_control_or_non_ascii", "GET / HTTP/1.1\r\nHost: localhost\r\nX: " + value + "\r\n\r\n")
    }
    for field in ["Transfer-Encoding: chunked", "Content-Length: 1", "Content-Length: -1", "Content-Length: ", "Content-Length: 0\r\nContent-Length: 0"] {
      AdvancedTests.bad("body_framing", "GET / HTTP/1.1\r\nHost: localhost\r\n" + field + "\r\n\r\n")
    }
    AdvancedTests.bad("pure_rejects_body", root + "x")
    AdvancedTests.bad("pure_rejects_pipeline", root + root)
    AdvancedTests.bad("source_like_method_is_data", "$" + "{raise :injected} / HTTP/1.1\r\nHost: localhost\r\n\r\n")
    AdvancedTests.check("source_like_header_is_data", "GET / HTTP/1.1\r\nHost: localhost\r\nX: $" + "{raise :injected}\r\n\r\n", "200 OK", plain, "你好，Iris!\n")
    mut padding = ""
    let prefix = "GET / HTTP/1.1\r\nHost: localhost\r\nX: "
    while padding.byte_length() < 8192 - prefix.byte_length() - 4 { padding = padding + "a" }
    AdvancedTests.check("8192_bytes", prefix + padding + "\r\n\r\n", "200 OK", plain, "你好，Iris!\n")
    AdvancedTests.bad("8193_bytes", prefix + padding + "a\r\n\r\n")
    AdvancedTests.bad("utf8_overflow", prefix + padding + "é\r\n\r\n")
    mut many = "GET / HTTP/1.1\r\nHost: localhost\r\n"
    mut count = 1
    while count < 64 { many = many + "X: a\r\n"; count = count + 1 }
    AdvancedTests.check("64_fields", many + "\r\n", "200 OK", plain, "你好，Iris!\n")
    AdvancedTests.bad("65_fields", many + "X: a\r\n\r\n")
    let request: Request = Http.parse(root)
    AdvancedTests.equal("typed_request_path", request.path, "/")
    AdvancedTests.equal("constructor_boundary", try { Request.new(12) } catch error { error.to_string() }, "TypeContractError")
    AdvancedTests.equal("contract_pipeline", Pipeline.run(Router.new(), request).body, "你好，Iris!\n")
    AdvancedTests.equal("decorator_metadata", Pipeline.marker(), "advanced_v1")
    let arguments = Router.decorator_arguments
    AdvancedTests.equal("metadata_readonly", try { arguments.append([:forged]) } catch error { error.to_string() }, "ReadonlyMutationError")
    AdvancedTests.equal("unknown_failure_propagates", try { Pipeline.run(UnexpectedHandler.new(), request) } catch error { error.to_string() }, "UnexpectedFailure")
    print("Advanced HTTP tests passed: 75")
    nil
  }
}

class UnexpectedHandler for HandlerContract {
  public impl fun handle(request: Request) -> Response { raise :UnexpectedFailure }
}

AdvancedTests.run()
