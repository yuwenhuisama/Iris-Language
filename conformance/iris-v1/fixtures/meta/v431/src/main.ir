contract ClassDecorator { fun transform(declaration, arguments, context) }
class First {
  public fun transform(declaration, arguments, context) -> Transformation {
    Transformation.empty.add_method(:first) { :first }
  }
}
impl First for ClassDecorator {}
class Second {
  public fun transform(declaration, arguments, context) -> Transformation {
    Transformation.empty.add_method(:second) { :second }
  }
}
impl Second for ClassDecorator {}
@First() @Second() class Box { }
