class Effects {
    public class property wrapper: Integer = 0
    public class property body: Integer = 0
}
class Cache {}
impl Cache for MethodDecorator {
    public fun plan(declaration, arguments) -> Plan { Plan.empty }
    public fun transform(declaration, arguments, context) -> Transformation {
        Transformation.wrap_method({ async |invocation: Invocation, next: Closure<(ArgumentChanges) -> Task<Object>>| -> Object;
            Effects.wrapper = Effects.wrapper + 1
            7
        })
    }
}
class Target {
    @Cache()
    public async fun value(value: Integer) -> Integer { Effects.body = Effects.body + 1; value }
}
let input: Object = "wrong"
let task = Target.new().value(input)
print(:returned)
print(Effects.wrapper)
print(Effects.body)
try { Host.run(task) } catch error { print(error is? TypeError) }
print(Effects.wrapper)
print(Effects.body)
