class Effects {
    public class property inner: Integer = 0
    public class property body: Integer = 0
}
class Reject {}
impl Reject for MethodDecorator {
    public fun plan(declaration, arguments) -> Plan { Plan.empty }
    public fun transform(declaration, arguments, context) -> Transformation {
        Transformation.wrap_method({ |invocation: Invocation, next: Closure<(ArgumentChanges) -> Object>| -> Object;
            let rest: Array<Object> = %[]
            let keywords: Hash<Symbol, Object> = %{}
            try { next.call(ArgumentChanges.new(rest: rest)) } catch error { print(error is? ArgumentError) }
            try { next.call(ArgumentChanges.new(keyword_rest: keywords)) } catch error { print(error is? ArgumentError) }
            try { next.call(ArgumentChanges.new(block: nil)) } catch error { print(error is? ArgumentError) }
            try { next.call(changes: ArgumentChanges.empty) } catch error { print(error is? ArgumentError) }
            try { next.call() { || -> Integer; 9 } } catch error { print(error is? ArgumentError) }
            try { next.call(ArgumentChanges.empty, ArgumentChanges.empty) } catch error { print(error is? ArgumentError) }
            print(Effects.inner)
            print(Effects.body)
            next.call()
        })
    }
}
class Inner {}
impl Inner for MethodDecorator {
    public fun plan(declaration, arguments) -> Plan { Plan.empty }
    public fun transform(declaration, arguments, context) -> Transformation {
        Transformation.wrap_method({ |invocation: Invocation, next: Closure<(ArgumentChanges) -> Object>| -> Object;
            Effects.inner = Effects.inner + 1
            next.call()
        })
    }
}
class Target {
    @Reject()
    @Inner()
    public fun value() -> Integer { Effects.body = Effects.body + 1; 7 }
}
print(Target.new().value())
print(Effects.inner)
print(Effects.body)
