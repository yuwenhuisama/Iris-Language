class Effects {
    public class property inner: Integer = 0
    public class property body: Integer = 0
}
class BadPatch {}
impl BadPatch for MethodDecorator {
    public fun plan(declaration, arguments) -> Plan { Plan.empty }
    public fun transform(declaration, arguments, context) -> Transformation {
        Transformation.wrap_method({ |invocation: Invocation, next: Closure<(ArgumentChanges) -> Object>| -> Object;
            let fixed: Hash<Symbol, Object> = %{:value: "wrong"}
            next.call(ArgumentChanges.new(positional: fixed))
        })
    }
}
class Inner {}
impl Inner for MethodDecorator {
    public fun plan(declaration, arguments) -> Plan { Plan.empty }
    public fun transform(declaration, arguments, context) -> Transformation {
        Transformation.wrap_method({ |invocation: Invocation, next: Closure<(ArgumentChanges) -> Object>| -> Object;
            Effects.inner = Effects.inner + 1
            next.call()
        })
    }
}
class Target {
    @BadPatch()
    @Inner()
    public fun value(value: Integer) -> Integer { Effects.body = Effects.body + 1; value }
}
try { Target.new().value(7) } catch error { print(error is? TypeError) }
print(Effects.inner)
print(Effects.body)
